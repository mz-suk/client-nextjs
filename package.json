{
  "name": "client-nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 16 + React 19 + TypeScript 기반 범용 프로젝트 템플릿",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "pnpm build && npx serve out -l 4000",
    "lint": "tsc --noEmit && eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,scss,md}\"",
    "prepare": "husky",
    "analyze": "ANALYZE=true next build",
    "gf": "git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -d",
    "gfl": "git branch | grep -v '^*' | xargs git branch -D",
    "clean:empty": "./scripts/remove-empty-dirs.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.17",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@tanstack/react-virtual": "^3.13.18",
    "next": "16.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.1.2",
    "@types/node": "^25.0.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.0",
    "sass": "^1.97.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
